<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Facilities Booking</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container py-5">
    <h1 class="text-center mb-4">Available Facilities</h1>
    <div class="row g-4">
      {{#each reservations}}
        <div class="col-md-4">
          <div class="card h-100">
            <img src="/images/{{this.image}}" class="card-img-top" alt="{{this.name}}">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title">{{this.name}}</h5>
                <p class="card-text">{{this.description}}</p>
              </div>
              <button class="btn btn-success mt-3" onclick="openReservation('{{this._id}}')">Κάνε Κράτηση</button>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>
</body>
</html>
